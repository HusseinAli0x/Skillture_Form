# Copy to .env and fill in. Variable names here must match the keys read in
# internal/config/config.go — a typo means the value is silently ignored and
# the default is used instead.

# ---- Database ----
# The postgres container is configured from POSTGRES_*; the Go application
# reads DB_*. Keep the two sets in sync — they describe the same database.
POSTGRES_USER=skillture
POSTGRES_PASSWORD=change_me
POSTGRES_DB=skillturedb

DB_HOST=localhost
# 5433 matches the host-side port published by docker-compose. Inside the
# compose network the backend talks to postgres_db:5432.
DB_PORT=5433
DB_USER=skillture
DB_PASSWORD=change_me
DB_NAME=skillturedb
DB_SSL_MODE=disable

DB_MAX_OPEN_CONNS=50
DB_MIN_CONNS=10
DB_CONN_MAX_LIFETIME=3600
DB_CONN_MAX_IDLE_TIME=1800
DB_CONNECT_TIMEOUT=10
DB_QUERY_TIMEOUT=30

# ---- Server ----
# SERVER_HOST / SERVER_PORT apply to local runs; docker-compose overrides them
# to 127.0.0.1:8081 behind Caddy.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# development | staging | production. Set to production on the live server
# (docs/DEPLOY.md); it also requires APP_SECRET_KEY.
ENV=development
# Required when ENV=production. Generate one with: openssl rand -base64 48
APP_SECRET_KEY=
SERVER_READ_TIMEOUT=60
SERVER_WRITE_TIMEOUT=60
SERVER_IDLE_TIMEOUT=120

# ---- Authentication ----
# REQUIRED. Must be at least 32 characters or the application refuses to start.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=skillture-api
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=7
BCRYPT_COST=12

# ---- Security ----
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MIN=15
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MIN=15
# Comma-separated CIDRs or IPs of proxies in front of the API. Under
# docker-compose this is overridden to loopback (Caddy runs in the same container).
TRUSTED_PROXIES=127.0.0.1,::1

# ---- CORS ----
# Comma-separated origins allowed to call the API from a browser. The frontend
# is served from the same origin through Caddy, so this only matters for
# separate-origin deployments and local dev against the Vite server.
# Same-origin requests (including the game WebSocket) work without being listed.
# Production: CORS_ALLOWED_ORIGINS=https://skilltrue.club
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5175
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=text

# ---- Uploads ----
UPLOAD_BASE_PATH=./uploads
UPLOAD_MAX_FILE_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=png,jpg,jpeg,webp,gif

# ---- Google Gemini (AI analytics panel) ----
# Leave blank to disable the AI report; the endpoint then returns an error
# rather than fabricating a report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
