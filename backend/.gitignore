# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Env files
.env
.env.local

# App-specific. Anchored to the module root so a future `internal/main/`
# package is not silently ignored.
uploads/
/main
/tmp_build
