# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled Go binaries produced by local builds. Anchored so a future
# package directory named e.g. internal/main/ is not silently ignored.
/api
/main
/backend/main
/backend/tmp_build

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories
vendor/
node_modules/

# Build output
dist/
build/

# Go workspace file
go.work
go.work.sum

# env files
.env
.env.local
.env.*.local

# Editor/IDE
.idea/
.vscode/
.DS_Store

# Local artifacts
*.log
.DS_Store
/res/
